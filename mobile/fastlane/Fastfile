default_platform(:ios)

require 'fileutils'
require 'json'
require 'spaceship'

APP_SCHEME = 'FullHouse'
IOS_CONFIGURATION = 'Release'
APPLE_TEAM_ID = 'UT62KQGZDJ'
IOS_APP_IDENTIFIER = 'com.kitchenhub.app'
ANDROID_PACKAGE_NAME = 'com.kitchenhub.app'
ANDROID_TRACKS = %w[internal alpha beta production].freeze
INITIAL_STORE_VERSION = '1.0.0'
MARKETING_VERSION_PATTERN = /\A(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)\z/

MOBILE_ROOT = File.expand_path('..', __dir__)
IOS_ROOT = File.join(MOBILE_ROOT, 'ios')
IOS_WORKSPACE = File.join(IOS_ROOT, 'FullHouse.xcworkspace')
IOS_XCODEPROJ = File.join(IOS_ROOT, 'FullHouse.xcodeproj')
IOS_METADATA_PATH = File.join(MOBILE_ROOT, 'fastlane', 'metadata', 'ios')
IOS_SCREENSHOTS_PATH = File.join(MOBILE_ROOT, 'fastlane', 'screenshots')
ANDROID_METADATA_PATH = File.join(MOBILE_ROOT, 'fastlane', 'metadata', 'android')
ANDROID_GRADLE_PROJECT_DIR = File.join(MOBILE_ROOT, 'android')
ANDROID_AAB_PATH = File.join(
  ANDROID_GRADLE_PROJECT_DIR,
  'app',
  'build',
  'outputs',
  'bundle',
  'release',
  'app-release.aab',
)

def ensure_env!(key)
  value = ENV[key]
  UI.user_error!("Missing required env var: #{key}") if value.nil? || value.strip.empty?
  value.strip
end

def ensure_release_api_url!
  api_url = ensure_env!('EXPO_PUBLIC_API_URL')
  if api_url.match?(/localhost|127\.0\.0\.1|10\.0\.2\.2/i)
    UI.user_error!("EXPO_PUBLIC_API_URL must point to a deployed backend, got: #{api_url}")
  end
  api_url
end

def read_repo_version
  # version.json lives at the repo root (two levels up from mobile/fastlane/)
  version_json_path = File.expand_path('../../version.json', __dir__)
  JSON.parse(File.read(version_json_path))['version']
rescue
  nil
end

def read_repo_version!
  version = read_repo_version
  UI.user_error!('Unable to resolve repo version from version.json') if version.nil? || version.strip.empty?
  version
end

def read_react_native_version
  react_native_package_path = File.join(MOBILE_ROOT, 'node_modules', 'react-native', 'package.json')
  JSON.parse(File.read(react_native_package_path))['version']
rescue
  nil
end

def app_store_api_key!
  ensure_env!('ASC_KEY_ID')
  ensure_env!('ASC_ISSUER_ID')
  ensure_env!('ASC_KEY_PATH')

  app_store_connect_api_key(
    key_id: ENV['ASC_KEY_ID'],
    issuer_id: ENV['ASC_ISSUER_ID'],
    key_filepath: ENV['ASC_KEY_PATH'],
    in_house: false,
  )
end

def configure_local_ios_build_environment!
  ENV['RCT_USE_RN_DEP'] = '1'
  ENV['RCT_USE_PREBUILT_RNCORE'] = '1'
end

# expo prebuild generates the .xcodeproj with automatic signing.
# This switches every target in the project to manual signing so that
# xcodebuild uses the Match certificate + profile that is already installed
# in the CI keychain, instead of trying to contact Apple developer portal.
def configure_code_signing!
  update_code_signing_settings(
    use_automatic_signing: false,
    path:                  IOS_XCODEPROJ,
    team_id:               APPLE_TEAM_ID,
    code_sign_identity:    'Apple Distribution',
    profile_name:          "match AppStore #{IOS_APP_IDENTIFIER}",
    bundle_identifier:     IOS_APP_IDENTIFIER,
  )
end

def ensure_hermes_artifact!(configuration)
  react_native_version = read_react_native_version
  UI.user_error!('Unable to resolve the React Native version for Hermes artifacts') if react_native_version.nil? || react_native_version.strip.empty?

  normalized_configuration = configuration.downcase
  hermes_artifact_directory = File.join(IOS_ROOT, 'Pods', 'hermes-engine-artifacts')
  hermes_artifact_path = File.join(
    hermes_artifact_directory,
    "hermes-ios-#{react_native_version.downcase}-#{normalized_configuration}.tar.gz",
  )
  temporary_download_path = File.join(hermes_artifact_directory, 'hermes-ios.download')

  return if File.exist?(hermes_artifact_path)

  hermes_artifact_url = [
    'https://repo1.maven.org/maven2/com/facebook/react/react-native-artifacts',
    react_native_version,
    "react-native-artifacts-#{react_native_version}-hermes-ios-#{normalized_configuration}.tar.gz",
  ].join('/')

  UI.message("Downloading Hermes #{normalized_configuration} artifact for React Native #{react_native_version}")

  FileUtils.mkdir_p(hermes_artifact_directory)
  FileUtils.rm_f(temporary_download_path)

  sh(
    'curl',
    '-fL',
    '--retry',
    '5',
    '--retry-delay',
    '2',
    '--retry-all-errors',
    hermes_artifact_url,
    '-o',
    temporary_download_path,
  )
  FileUtils.mv(temporary_download_path, hermes_artifact_path)
end

def install_ios_pods!
  Dir.chdir(IOS_ROOT) do
    utf8_env = { 'LANG' => 'en_US.UTF-8', 'LC_ALL' => 'en_US.UTF-8' }
    max_install_attempts = 3

    libwebp_src = File.join('Pods', 'libwebp', 'src')
    unless File.exist?(File.join(libwebp_src, 'webp', 'types.h'))
      UI.message('[pods] libwebp src/ tree is incomplete — cleaning pod cache and Pods/libwebp to force a full re-download')
      sh(utf8_env, 'bundle', 'exec', 'pod', 'cache', 'clean', 'libwebp', '--all') rescue nil
      FileUtils.rm_rf(File.join('Pods', 'libwebp'))
    end

    attempts = 0
    begin
      attempts += 1
      sh(utf8_env, 'bundle', 'exec', 'pod', 'install')
    rescue => error
      message = error.message.to_s
      transient_failure = message.match?(/RPC failed/i) ||
        message.match?(/The requested URL returned error:\s*5\d\d/i) ||
        message.match?(/timed out/i) ||
        message.match?(/Failed to open TCP connection/i) ||
        message.match?(/Could not resolve host/i)

      raise unless transient_failure && attempts < max_install_attempts

      wait_seconds = attempts * 10
      UI.important("[pods] pod install transient failure (attempt #{attempts}/#{max_install_attempts}): #{message}")
      UI.important("[pods] cleaning SDWebImageWebPCoder cache and retrying in #{wait_seconds}s...")
      sh(utf8_env, 'bundle', 'exec', 'pod', 'cache', 'clean', 'SDWebImageWebPCoder', '--all') rescue nil
      FileUtils.rm_rf(File.join('Pods', 'SDWebImageWebPCoder'))
      sleep(wait_seconds)
      retry
    end
  end
end

def next_ios_build_number(api_key:, version:)
  latest_build_number = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: IOS_APP_IDENTIFIER,
    version: version,
    initial_build_number: 0,
  )

  latest_build_number.to_i + 1
rescue => error
  UI.important("Unable to read latest TestFlight build number (#{error.message}); defaulting to 1")
  1
end

def latest_ios_build_for_version!(api_key:, version:)
  build_number = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: IOS_APP_IDENTIFIER,
    version: version,
    initial_build_number: 0,
  ).to_i

  UI.user_error!("No TestFlight build found for iOS version #{version}. Run `fastlane ios internal` first.") if build_number < 1

  build_number
end

def parse_marketing_version!(version, allow_short_patch: false)
  normalized = version.to_s.strip
  pattern = allow_short_patch ? /^\d+\.\d+(\.\d+)?$/ : MARKETING_VERSION_PATTERN
  expected = allow_short_patch ? 'MAJOR.MINOR or MAJOR.MINOR.PATCH' : 'MAJOR.MINOR.PATCH'
  UI.user_error!("Invalid store marketing version '#{version}'. Expected #{expected}.") unless normalized.match?(pattern)

  parts = normalized.split('.').map(&:to_i)
  parts << 0 while parts.length < 3
  parts
end

def compare_marketing_versions(left, right, allow_short_patch: false)
  left_parts = parse_marketing_version!(left, allow_short_patch: allow_short_patch)
  right_parts = parse_marketing_version!(right, allow_short_patch: allow_short_patch)

  left_parts.each_with_index do |left_part, index|
    right_part = right_parts[index]
    return 1 if left_part > right_part
    return -1 if left_part < right_part
  end

  0
end

def ensure_non_stale_store_version!(version)
  parse_marketing_version!(version)
  UI.user_error!(
    'version.json is still 1.0.0. Bump the store marketing version before uploading a production store build.',
  ) if version.to_s.strip == INITIAL_STORE_VERSION
end

def latest_ios_app_store_version!(api_key:)
  # app_store_connect_api_key configures Spaceship's ConnectAPI token. Keep the
  # api_key parameter to make the dependency explicit at call sites.
  UI.user_error!('App Store Connect API key was not configured') if api_key.nil?

  app = Spaceship::ConnectAPI::App.find(IOS_APP_IDENTIFIER)
  UI.user_error!("Could not find App Store Connect app #{IOS_APP_IDENTIFIER}") if app.nil?

  live_version = app.get_live_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
  live_version&.version_string
rescue => error
  UI.user_error!("Unable to read current App Store version for #{IOS_APP_IDENTIFIER}: #{error.message}")
end

def validate_ios_marketing_version!(api_key:, version:)
  ensure_non_stale_store_version!(version)
  current_store_version = latest_ios_app_store_version!(api_key: api_key)

  if current_store_version && !current_store_version.to_s.strip.empty?
    if compare_marketing_versions(version, current_store_version, allow_short_patch: true) <= 0
      UI.user_error!(
        "iOS marketing version #{version} must be greater than current App Store version #{current_store_version}. Bump repo-root version.json before TestFlight upload.",
      )
    end

    UI.message("Validated iOS marketing version #{version} > current App Store version #{current_store_version}")
  else
    UI.important('No live App Store version was returned; validated static store version format only.')
  end

  version
end

def validate_android_marketing_version!(version)
  ensure_non_stale_store_version!(version)
  version
end

def ensure_store_asset_path!(path, label)
  UI.user_error!("#{label} path does not exist: #{path}") unless File.directory?(path)
  UI.user_error!("#{label} path is empty: #{path}") if Dir.glob(File.join(path, '**', '*')).select { |entry| File.file?(entry) }.empty?
end

def android_existing_version_codes!(json_key:)
  lookup_failed = false

  existing_version_codes = ANDROID_TRACKS.flat_map do |track|
    response = google_play_track_version_codes(
      json_key: json_key,
      package_name: ANDROID_PACKAGE_NAME,
      track: track,
    )

    Array(response).map(&:to_i).select { |code| code.positive? }
  rescue => error
    # fastlane/supply can currently raise (sometimes wrapped):
    #   undefined method `flat_map' for nil
    # when a track has no releases metadata. In that case, the safe behavior
    # is to treat the track as having no existing version codes.
    if error.message.to_s.match?(/undefined method [`']flat_map[`'] for nil/i)
      UI.important(
        "Track '#{track}' returned no releases metadata from Google Play; treating as an empty track.",
      )
      lookup_failed = true
      []
    else
      # If we end up here, something is genuinely wrong with the Play API call
      # (auth, network, rate-limit, etc.). Silently returning [] would exclude
      # that track's version codes from the max calculation and could produce a
      # next_version_code lower than an existing release, causing Google Play to
      # reject the upload after a ~25-minute build.
      # Fail fast here so the engineer can investigate before wasting CI time.
      UI.error("Failed to fetch version codes for track '#{track}': #{error.message}")
      UI.error("Cannot safely compute next versionCode — aborting to prevent upload with a stale/wrong code.")
      raise
    end
  end

  [existing_version_codes.uniq.sort, lookup_failed]
end

def next_android_version_code(existing_version_codes:, lookup_failed:)
  next_from_tracks = (existing_version_codes.max || 0) + 1
  return next_from_tracks unless lookup_failed

  # Guard against incomplete Play track metadata responses by applying a
  # monotonic time-based floor for versionCode. Keeps uploads upgradeable even
  # when one or more tracks cannot be read reliably.
  fallback_floor = 100_000_000 + (Time.now.to_i / 60)
  chosen_version_code = [next_from_tracks, fallback_floor].max
  UI.important(
    "One or more Play tracks could not be read reliably; using fallback versionCode floor #{fallback_floor} (chosen #{chosen_version_code}).",
  )
  chosen_version_code
end

def android_signing_properties!
  {
    'android.injected.signing.store.file' => ensure_env!('ANDROID_KEYSTORE_PATH'),
    'android.injected.signing.store.password' => ensure_env!('ANDROID_KEYSTORE_PASSWORD'),
    'android.injected.signing.key.alias' => ensure_env!('ANDROID_KEY_ALIAS'),
    'android.injected.signing.key.password' => ensure_env!('ANDROID_KEY_PASSWORD'),
  }
end

def configure_android_gradle_version!(version_code:, version_name:)
  build_gradle_path = File.join(ANDROID_GRADLE_PROJECT_DIR, 'app', 'build.gradle')
  UI.user_error!("Android build.gradle not found at #{build_gradle_path}. Did Expo prebuild run?") unless File.exist?(build_gradle_path)

  contents = File.read(build_gradle_path)
  updated = contents.gsub(/versionCode\s+\d+/, "versionCode #{version_code}")
  updated = updated.gsub(/versionName\s+[\"'][^\"']+[\"']/, "versionName \"#{version_name}\"")

  UI.user_error!("Could not update Android versionCode in #{build_gradle_path}") unless updated.include?("versionCode #{version_code}")
  UI.user_error!("Could not update Android versionName in #{build_gradle_path}") unless updated.include?("versionName \"#{version_name}\"")

  File.write(build_gradle_path, updated)
  UI.message("Updated Android Gradle versionCode/versionName before bundling")
end

def build_android_aab!(version_code:, version_name:)
  configure_android_gradle_version!(version_code: version_code, version_name: version_name)

  gradle(
    task: 'bundle',
    build_type: 'Release',
    project_dir: ANDROID_GRADLE_PROJECT_DIR,
    properties: android_signing_properties!,
  )
end

platform :ios do
  desc 'Build and upload a new internal iOS build to TestFlight'
  lane :internal do
    ensure_release_api_url!
    setup_ci if ENV['CI']

    repo_version = read_repo_version!
    UI.message("Repo version.json: #{repo_version}")

    configure_local_ios_build_environment!
    api_key = app_store_api_key!
    release_version = validate_ios_marketing_version!(api_key: api_key, version: repo_version)

    match(
      type: 'appstore',
      app_identifier: IOS_APP_IDENTIFIER,
      readonly: true,
      api_key: api_key,
    )

    configure_code_signing!

    increment_version_number(
      version_number: release_version,
      xcodeproj: IOS_XCODEPROJ,
    )
    increment_build_number(
      build_number: next_ios_build_number(api_key: api_key, version: release_version),
      xcodeproj: IOS_XCODEPROJ,
    )

    install_ios_pods!
    ensure_hermes_artifact!(IOS_CONFIGURATION)

    build_app(
      workspace: IOS_WORKSPACE,
      scheme: APP_SCHEME,
      configuration: IOS_CONFIGURATION,
      export_method: 'app-store',
      clean: true,
      export_options: {
        method: 'app-store',
        signingStyle: 'manual',
        teamID: APPLE_TEAM_ID,
        provisioningProfiles: {
          IOS_APP_IDENTIFIER => 'match AppStore com.kitchenhub.app',
        },
      },
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false,
    )
  end

  desc 'Alias for the internal iOS TestFlight lane'
  lane :beta do
    internal
  end

  desc 'Archive only — no TestFlight upload. Use in CI to verify compilation.'
  lane :build_check do
    ensure_release_api_url!
    setup_ci if ENV['CI']

    repo_version = read_repo_version!
    UI.message("Repo version.json: #{repo_version}")

    configure_local_ios_build_environment!
    api_key = app_store_api_key!
    release_version = validate_ios_marketing_version!(api_key: api_key, version: repo_version)

    match(
      type: 'appstore',
      app_identifier: IOS_APP_IDENTIFIER,
      readonly: true,
      api_key: api_key,
    )

    configure_code_signing!

    increment_version_number(
      version_number: release_version,
      xcodeproj: IOS_XCODEPROJ,
    )
    increment_build_number(
      build_number: 0,
      xcodeproj: IOS_XCODEPROJ,
    )

    install_ios_pods!
    ensure_hermes_artifact!(IOS_CONFIGURATION)

    build_app(
      workspace: IOS_WORKSPACE,
      scheme: APP_SCHEME,
      configuration: IOS_CONFIGURATION,
      export_method: 'app-store',
      clean: true,
      skip_package_ipa: true,
      export_options: {
        method: 'app-store',
        signingStyle: 'manual',
        teamID: APPLE_TEAM_ID,
        provisioningProfiles: {
          IOS_APP_IDENTIFIER => 'match AppStore com.kitchenhub.app',
        },
      },
    )
    UI.success('iOS archive succeeded — build is valid.')
  end

  desc 'Submit the latest tested TestFlight iOS build for App Store review'
  lane :prod do
    ensure_release_api_url!
    repo_version = read_repo_version!
    api_key = app_store_api_key!
    release_version = validate_ios_marketing_version!(api_key: api_key, version: repo_version)
    build_number = latest_ios_build_for_version!(api_key: api_key, version: release_version)

    upload_to_app_store(
      api_key: api_key,
      app_version: release_version,
      build_number: build_number.to_s,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
    )
  end
  desc 'Upload App Store listing metadata and screenshots only; no binary upload or review submission'
  lane :store_assets do
    api_key = app_store_api_key!
    ensure_store_asset_path!(IOS_METADATA_PATH, 'iOS metadata')
    ensure_store_asset_path!(IOS_SCREENSHOTS_PATH, 'iOS screenshots')

    upload_to_app_store(
      api_key: api_key,
      app_identifier: IOS_APP_IDENTIFIER,
      skip_binary_upload: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: false,
      skip_screenshots: false,
      metadata_path: IOS_METADATA_PATH,
      screenshots_path: IOS_SCREENSHOTS_PATH,
      precheck_include_in_app_purchases: false,
    )
  end
end

platform :android do
  desc 'Build and upload a new internal Android release to Google Play'
  lane :internal do
    ensure_release_api_url!
    json_key = ensure_env!('SUPPLY_JSON_KEY')
    repo_version = validate_android_marketing_version!(read_repo_version!)
    existing_version_codes, version_code_lookup_failed = android_existing_version_codes!(json_key: json_key)
    next_version_code = next_android_version_code(
      existing_version_codes: existing_version_codes,
      lookup_failed: version_code_lookup_failed,
    )

    UI.message("Repo version.json: #{repo_version}")
    UI.message("Android versionCode: #{next_version_code}")
    UI.message("Existing Android versionCodes used for next-code calculation: #{existing_version_codes.join(', ')}")

    build_android_aab!(
      version_code: next_version_code,
      version_name: repo_version,
    )

    upload_to_play_store(
      json_key: json_key,
      package_name: ANDROID_PACKAGE_NAME,
      track: 'internal',
      aab: ANDROID_AAB_PATH,
      release_status: 'completed',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end

  desc 'Build release AAB only — no Play Store upload. Use in CI to verify compilation.'
  lane :build_check do
    ensure_release_api_url!
    repo_version = validate_android_marketing_version!(read_repo_version!)
    UI.message("Repo version.json: #{repo_version}")

    build_android_aab!(
      version_code: 1,
      version_name: repo_version,
    )
    UI.success("Android AAB build succeeded — #{ANDROID_AAB_PATH}")
  end

  desc 'Promote the tested Android internal release to the production track as a draft'
  lane :prod do
    json_key = ensure_env!('SUPPLY_JSON_KEY')

    upload_to_play_store(
      json_key: json_key,
      package_name: ANDROID_PACKAGE_NAME,
      track: 'internal',
      track_promote_to: 'production',
      track_promote_release_status: 'draft',
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end

  desc 'Upload Google Play listing metadata and screenshots only; no binary upload or rollout'
  lane :store_assets do
    json_key = ensure_env!('SUPPLY_JSON_KEY')
    ensure_store_asset_path!(ANDROID_METADATA_PATH, 'Android metadata')

    upload_to_play_store(
      json_key: json_key,
      package_name: ANDROID_PACKAGE_NAME,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      skip_upload_changelogs: true,
      metadata_path: ANDROID_METADATA_PATH,
      changes_not_sent_for_review: true,
    )
  end
end
